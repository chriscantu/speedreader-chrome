# Dependencies
node_modules/

# Build output
dist/
build/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage
coverage/
.nyc_output/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# TypeScript
*.tsbuildinfo

# Local state for issue-creation scripts
scripts/.milestone-numbers.tsv

# Local session-bridge handoff notes (not load-bearing decisions)
_handoff*.md

# Harness runtime state (per-machine)
.claude/memory/
.claude/sessions/
.claude/state/

# Ruflo agent definitions (regenerated by `ruflo init`)
.claude/agents/
.claude/commands/
.claude/helpers/

# Ruflo-generated Claude Code settings — depends on .claude/helpers/ which is
# regenerable per-machine via `ruflo init`. Committing it pins the maintainer's
# platform (claudeFlow.platform: darwin/arm64/zsh) onto every cloner and breaks
# fresh-clone hooks when the helpers haven't been generated yet.
.claude/settings.json

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Harness state inside nested workspaces (root .claude/ is partially tracked; nested ones are runtime-only)
experiments/**/.claude/

# Ruflo runtime state
.claude-flow/
.claude/memory.db
.swarm/
ruvector.db
.harness-mem/
.ring-output/

# Coverage / profiling
default.profraw
out/
