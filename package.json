{
  "name": "speedreader-chrome",
  "version": "0.1.0",
  "description": "SpeedReader for Chrome - RSVP reading accessibility extension",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:d10": "playwright test --config experiments/activeTab-commands-check/playwright.config.ts",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^25.9.1",
    "@types/sinon-chrome": "^2.2.16",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "sinon-chrome": "^3.0.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^6.3.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "overrides": {
    "rollup@<2.80.0": "2.80.0"
  }
}
